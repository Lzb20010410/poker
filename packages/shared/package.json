{
  "name": "@poker-room/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "德州扑克纯规则逻辑 — 零 IO、零框架依赖。整个项目的命脉。",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine/index.ts",
    "./view": "./src/view.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "pokersolver": "2.1.4"
  }
}
