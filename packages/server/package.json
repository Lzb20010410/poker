{
  "name": "@poker-room/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Colyseus 服务端 — 只做权威判定与状态同步，不含游戏规则逻辑（规则在 shared/engine）",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.34",
    "@poker-room/shared": "workspace:*",
    "colyseus": "^0.18.8",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@colyseus/testing": "^0.18.6",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
