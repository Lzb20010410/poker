    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@dicebear/core": "^9.4.3",
    "@dicebear/notionists": "^9.4.2",
    "@poker-room/shared": "workspace:*",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^30.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
