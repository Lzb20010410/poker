{
  "name": "@poker-room/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React 前端 — 只做渲染状态 + 播动画 + 收集操作，不含游戏规则逻辑",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
