{
  "name": "poker-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "私局德州扑克 — 朋友局用途，非商业运营，不涉及任何真实价值交换",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:cov": "pnpm --filter @poker-room/shared test -- --coverage",
    "lint": "eslint . && node scripts/check-arch.mjs",
    "lint:fix": "eslint . --fix",
    "lint:arch": "node scripts/check-arch.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css,html}\"",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@9.15.0"
}
